<Window x:Class="Snow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Snow.App.Views"
        Title="Snow Apps" Width="1240" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Snow;component/Assets/snow.png"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────────── Barra lateral ───────────── -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Image Source="pack://application:,,,/Snow;component/Assets/snow.png" Width="40" Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SNOW" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="APPS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="10" Background="{DynamicResource AccentBgBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" Content="Atualizar agora" Margin="0,8,0,0" Padding="12,6"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,0,10" HorizontalAlignment="Left"
                            Background="{DynamicResource GoodBgBrush}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="● Administrador" FontSize="11" Foreground="{DynamicResource GoodBrush}"/>
                    </Border>
                    <Button Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding ThemeIcon}" FontSize="14"/>
                            <TextBlock Text="{Binding ThemeLabel}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <DockPanel Margin="4,10,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding CheckUpdatesCommand}" Padding="6,2" FontSize="11" ToolTip="Verificar atualizações"
                                BorderThickness="0" Background="Transparent">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12"/>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · por Thiago Neves"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SNOW GAMING" Style="{StaticResource NavHeader}" Margin="12,0,0,6"/>
                    <RadioButton x:Name="NavDiag" Style="{StaticResource NavButton}" IsChecked="True" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/><TextBlock Text="Diagnóstico" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavOpt" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;"/><TextBlock Text="Otimizar Windows" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;"/><TextBlock Text="Jogos" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCanRun" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;"/><TextBlock Text="Roda no meu PC?" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;"/><TextBlock Text="Inicialização" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>

                    <TextBlock Text="SNOW HEALTH" Style="{StaticResource NavHeader}" Margin="12,18,0,6"/>
                    <RadioButton x:Name="NavHealth" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE95E;"/><TextBlock Text="Saúde do PC" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>

                    <TextBlock Text="SNOW MONITOR" Style="{StaticResource NavHeader}" Margin="12,18,0,6"/>
                    <RadioButton x:Name="NavMonitor" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;"/><TextBlock Text="Desempenho" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBench" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;"/><TextBlock Text="Pontuação e estresse" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>

                    <TextBlock Text="GERAL" Style="{StaticResource NavHeader}" Margin="12,18,0,6"/>
                    <RadioButton x:Name="NavRestore" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;"/><TextBlock Text="Restaurar" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" GroupName="nav">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/><TextBlock Text="Log" Margin="12,0,0,0"/></StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ───────────── Conteúdo ───────────── -->
        <Grid Grid.Column="1">
            <views:DiagnosticsView Visibility="{Binding IsChecked, ElementName=NavDiag, Converter={StaticResource BoolVis}}"/>
            <views:OptimizeView Visibility="{Binding IsChecked, ElementName=NavOpt, Converter={StaticResource BoolVis}}"/>
            <views:GamesView Visibility="{Binding IsChecked, ElementName=NavGames, Converter={StaticResource BoolVis}}"/>
            <views:CanRunView Visibility="{Binding IsChecked, ElementName=NavCanRun, Converter={StaticResource BoolVis}}"/>
            <views:StartupView Visibility="{Binding IsChecked, ElementName=NavStartup, Converter={StaticResource BoolVis}}"/>
            <views:HealthView Visibility="{Binding IsChecked, ElementName=NavHealth, Converter={StaticResource BoolVis}}"/>
            <views:MonitorView Visibility="{Binding IsChecked, ElementName=NavMonitor, Converter={StaticResource BoolVis}}"/>
            <views:BenchView Visibility="{Binding IsChecked, ElementName=NavBench, Converter={StaticResource BoolVis}}"/>
            <views:RestoreView Visibility="{Binding IsChecked, ElementName=NavRestore, Converter={StaticResource BoolVis}}"/>
            <views:LogView Visibility="{Binding IsChecked, ElementName=NavLog, Converter={StaticResource BoolVis}}"/>

            <!-- Barra de progresso global -->
            <Border VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="24,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Body}" Margin="0,0,0,8"/>
                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="False" Maximum="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
