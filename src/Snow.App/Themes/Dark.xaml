<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Dark: trocado em tempo de execução pelo ThemeManager (todas as referências são DynamicResource). -->
    <Color x:Key="BgColor">#0B1220</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0B1220"/>
    <Color x:Key="SidebarColor">#0D1628</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0D1628"/>
    <Color x:Key="SurfaceColor">#121C31</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121C31"/>
    <Color x:Key="Surface2Color">#18243D</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="#18243D"/>
    <Color x:Key="HoverColor">#1E2C49</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="#1E2C49"/>
    <Color x:Key="BorderColor">#243453</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#243453"/>
    <Color x:Key="TextColor">#E7EEF9</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#E7EEF9"/>
    <Color x:Key="MutedColor">#8EA3C2</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="#8EA3C2"/>
    <Color x:Key="AccentColor">#22B8FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#22B8FF"/>
    <Color x:Key="Accent2Color">#1D6FF2</Color>
    <SolidColorBrush x:Key="Accent2Brush" Color="#1D6FF2"/>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="GoodColor">#3DDC97</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="#3DDC97"/>
    <Color x:Key="WarnColor">#FFB547</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB547"/>
    <Color x:Key="BadColor">#FF5D6C</Color>
    <SolidColorBrush x:Key="BadBrush" Color="#FF5D6C"/>
    <Color x:Key="GoodBgColor">#123A2D</Color>
    <SolidColorBrush x:Key="GoodBgBrush" Color="#123A2D"/>
    <Color x:Key="WarnBgColor">#3A2E14</Color>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#3A2E14"/>
    <Color x:Key="BadBgColor">#3D1820</Color>
    <SolidColorBrush x:Key="BadBgBrush" Color="#3D1820"/>
    <Color x:Key="AccentBgColor">#10314F</Color>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#10314F"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B8FF" Offset="0"/>
        <GradientStop Color="#1D6FF2" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
