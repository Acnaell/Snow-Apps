<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Light: trocado em tempo de execução pelo ThemeManager (todas as referências são DynamicResource). -->
    <Color x:Key="BgColor">#F3F6FB</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#F3F6FB"/>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <Color x:Key="Surface2Color">#EEF3FA</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="#EEF3FA"/>
    <Color x:Key="HoverColor">#E3ECF8</Color>
    <SolidColorBrush x:Key="HoverBrush" Color="#E3ECF8"/>
    <Color x:Key="BorderColor">#D8E1EE</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8E1EE"/>
    <Color x:Key="TextColor">#0F1B2D</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#0F1B2D"/>
    <Color x:Key="MutedColor">#5A6B85</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6B85"/>
    <Color x:Key="AccentColor">#1A8FF0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#1A8FF0"/>
    <Color x:Key="Accent2Color">#1D6FF2</Color>
    <SolidColorBrush x:Key="Accent2Brush" Color="#1D6FF2"/>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="GoodColor">#12965F</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="#12965F"/>
    <Color x:Key="WarnColor">#B86E00</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="#B86E00"/>
    <Color x:Key="BadColor">#D33445</Color>
    <SolidColorBrush x:Key="BadBrush" Color="#D33445"/>
    <Color x:Key="GoodBgColor">#DDF5EA</Color>
    <SolidColorBrush x:Key="GoodBgBrush" Color="#DDF5EA"/>
    <Color x:Key="WarnBgColor">#FFF1D9</Color>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF1D9"/>
    <Color x:Key="BadBgColor">#FDE2E5</Color>
    <SolidColorBrush x:Key="BadBgBrush" Color="#FDE2E5"/>
    <Color x:Key="AccentBgColor">#DCEEFF</Color>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#DCEEFF"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A8FF0" Offset="0"/>
        <GradientStop Color="#1D6FF2" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
