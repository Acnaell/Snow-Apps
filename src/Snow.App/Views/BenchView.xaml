<UserControl x:Class="Snow.App.Views.BenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Bench}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <TextBlock Text="Pontuação e estresse" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Mede processador, memória e discos com pontuação para comparar antes e depois de mudanças, e faz teste de estresse com conferência de erros. Sem drivers: seguro com anti-cheat."/>

            <!-- Pontuação -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunBenchCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="13"/><TextBlock Text="Medir pontuação (~1 min)" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" Content="Cancelar"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teste de pontuação" Style="{StaticResource H2}"/>
                            <TextBlock Text="Discos testados (grava e lê 512 MB temporários, apagados no fim):" Style="{StaticResource Caption}" Margin="0,6,0,4"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"/>
                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{DynamicResource BadBrush}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0" Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Metric}" Style="{StaticResource Body}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Verdict}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="D" Grid.Column="2" Text="{Binding Delta}" Style="{StaticResource Caption}" TextAlignment="Right" Foreground="{DynamicResource BadBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Better}" Value="True"><Setter TargetName="D" Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Histórico" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Placa de vídeo: a pontuação da GPU precisa de renderização 3D e fica para uma próxima versão. Para estressar a GPU hoje, use um jogo pesado com o Desempenho aberto."/>
                </StackPanel>
            </Border>

            <!-- IA local -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RunAiCommand}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13"/><TextBlock Text="Testar IA local (~10 s)" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Roda IA no meu PC?" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding AiSummary}" Style="{StaticResource Caption}" Margin="0,6,12,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AiHardware}" Style="{StaticResource Caption}" Margin="0,4,12,0" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AiRows}" Margin="0,8,0,0" Visibility="{Binding HasAi, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Use}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="V" Grid.Column="1" Text="{Binding Verdict}" Style="{StaticResource Body}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Where}" Value="PlacaDeVideo"><Setter TargetName="V" Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Where}" Value="NaoCabe"><Setter TargetName="V" Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding AiNotes}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                               Text="Estimativa para modelos GGUF Q4_K_M. A banda da RAM e o cálculo do processador são medidos; a da placa de vídeo vem da especificação do fabricante. Erro típico: ±25%."/>
                </StackPanel>
            </Border>

            <!-- Estresse -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunStressCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13"/><TextBlock Text="Iniciar estresse" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding CancelCommand}" Content="Parar"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teste de estresse" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                                       Text="Carga máxima com conferência: cada cálculo e cada byte de memória testado é verificado. Mostra erros (instabilidade, pente com defeito) e queda de clock (temperatura ou energia)."/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StressCpu}" VerticalAlignment="Center"/>
                        <TextBlock Text="Processador" Style="{StaticResource Body}" Margin="8,0,24,0" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StressRam}" VerticalAlignment="Center"/>
                        <TextBlock Text="Memória RAM" Style="{StaticResource Body}" Margin="8,0,24,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" Background="Transparent" BorderThickness="0"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" HorizontalAlignment="Left">
                        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ProfileItem}"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="0"/></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Style="{StaticResource Body}" Margin="-4,-6"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Live}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    <ItemsControl ItemsSource="{Binding StressVerdicts}" Margin="0,8,0,0" Visibility="{Binding HasVerdicts, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <TextBlock x:Name="Ic" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource BadBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                        <Setter TargetName="Ic" Property="Text" Value="&#xE73E;"/>
                                        <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
