<UserControl x:Class="Snow.App.Views.CanRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding CanRun}">
    <UserControl.Resources>
        <DataTemplate x:Key="GameCard">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,10" Padding="16,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border x:Name="Pill" Style="{StaticResource Badge}" Margin="0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="PillText" Text="{Binding Level}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}"/>
                                    </Border>
                                    <Button Content="Fonte oficial" Command="{Binding OpenSourceCommand}" Margin="0,8,0,0" FontSize="11" Padding="8,3" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="15"/>
                                        <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="{Binding Installed, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="instalado" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Measured}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasMeasured, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMin}" Value="True"><Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsBelow}" Value="True"><Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <TextBlock Text="Roda no meu PC?" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,6" TextWrapping="Wrap"
                       Text="Compara o seu hardware com os requisitos oficiais de cada jogo (link da fonte em cada um). Quando você já mediu o jogo no Desempenho, o FPS real aparece junto."/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Busca -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13"/><TextBlock Text="Buscar na Steam" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10,7" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource TextBrush}">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Hits}" Margin="0,6,0,0" Visibility="{Binding HasHits, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><Button Content="{Binding Name}" Command="{Binding Command}" Margin="0,0,8,8"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding SearchResult}" ItemTemplate="{StaticResource GameCard}" Visibility="{Binding HasSearchResult, Converter={StaticResource BoolVis}}"/>
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource GameCard}"/>

            <TextBlock Style="{StaticResource Caption}" Margin="0,8,12,0" TextWrapping="Wrap"
                       Text="Os índices de processador e placa de vídeo são estimativas a partir de médias públicas de testes (margem de 10–15%). O resultado do Desempenho no seu PC vale mais que qualquer tabela."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
