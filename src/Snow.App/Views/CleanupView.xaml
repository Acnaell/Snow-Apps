<UserControl x:Class="Snow.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Maintenance}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <DockPanel Margin="0,0,12,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ScanCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/><TextBlock Text="Medir" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/><TextBlock Text="Limpar selecionados" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Limpeza e manutenção" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Libera espaço com o que o Windows e os apps recriam sozinhos, e cuida da vida útil das unidades. Nada de jogos, saves ou anti-cheat."/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTotal}" Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <DockPanel>
                                        <CheckBox x:Name="Chk" DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <Button x:Name="Open" DockPanel.Dock="Right" Content="Abrir no Windows" VerticalAlignment="Top" Margin="12,0,0,0" Visibility="Collapsed"
                                                Command="{Binding DataContext.OpenManualCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Body}" FontWeight="SemiBold" Width="80" TextAlignment="Right" VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Foreground="{DynamicResource BadBrush}" Visibility="{Binding HasSkipped, Converter={StaticResource BoolVis}}">
                                                <Run Text="Agora não: "/><Run Text="{Binding Skipped, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                        <Setter TargetName="Chk" Property="Visibility" Value="Hidden"/>
                                        <Setter TargetName="Open" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unidades -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Vida útil das unidades" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding DrivesText}" Style="{StaticResource Caption}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Command="{Binding EnableTrimCommand}" Content="Ligar TRIM" Margin="0,0,8,6" Visibility="{Binding TrimOff, Converter={StaticResource BoolVis}}"/>
                        <Button Command="{Binding EnableScheduleCommand}" Content="Religar otimização semanal" Margin="0,0,8,6" Visibility="{Binding ScheduleOff, Converter={StaticResource BoolVis}}"/>
                        <Button Command="{Binding OptimizeCommand}" Content="Otimizar unidades agora" Margin="0,0,8,6"/>
                        <Button Command="{Binding ComponentsCommand}" Content="Limpar componentes antigos do Windows" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="&quot;Otimizar&quot; usa a ferramenta do próprio Windows: envia TRIM para os SSDs e desfragmenta só os HDs (desfragmentar SSD não ajuda e gasta vida útil). Para a saúde dos discos (SMART), veja Saúde do PC."/>
                </StackPanel>
            </Border>

            <!-- O que não limpamos -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="O que o Snow não limpa, e por quê" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding NotCleaned}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><Run Text=": "/><Run Text="{Binding Value, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
