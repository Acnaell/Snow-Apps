<UserControl x:Class="Snow.App.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,90" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left" Margin="0,0,0,10">
                <TextBlock Text="EM DESENVOLVIMENTO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Self}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Subtitle, ElementName=Self}" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,6,0,20"/>
            <ItemsControl ItemsSource="{Binding Items, ElementName=Self}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Margin="0,6,14,0" Background="{DynamicResource AccentBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Footer, ElementName=Self}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
