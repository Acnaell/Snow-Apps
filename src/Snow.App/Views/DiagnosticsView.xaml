<UserControl x:Class="Snow.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,90">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CopyReportCommand}" Margin="0,0,8,0" ToolTip="Copia o diagnóstico completo em texto">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13"/><TextBlock Text="Copiar relatório" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/><TextBlock Text="Analisar novamente" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Diagnóstico do sistema" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Cartões de hardware -->
            <ItemsControl ItemsSource="{Binding Specs}" Margin="0,22,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentBgBrush}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" LineHeight="18"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Estado do Windows -->
                <Border Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Estado atual do Windows" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding StatusRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5">
                                        <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,12,0"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Good}" Value="False">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recomendação -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14" VerticalAlignment="Top" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Recomendação do Snow" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RecommendationText}" Style="{StaticResource Body}" LineHeight="20"/>
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Content="Ver otimizações recomendadas"
                                Click="GoToOptimize"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Achados -->
            <TextBlock Text="Achados (o que software não resolve sozinho)" Style="{StaticResource H2}" Margin="0,8,0,10"/>
            <ItemsControl ItemsSource="{Binding InsightItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Box" Style="{StaticResource Card}" Margin="0,0,14,10" Padding="16,12" Background="{DynamicResource SurfaceBrush}">
                            <DockPanel>
                                <TextBlock x:Name="Ic" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Critico">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BadBgBrush}"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Atencao">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
