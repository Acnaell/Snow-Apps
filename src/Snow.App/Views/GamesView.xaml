<UserControl x:Class="Snow.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Games}">
    <Grid Margin="32,28,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,12,18">
            <Button DockPanel.Dock="Right" Command="{Binding ScanCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/><TextBlock Text="Procurar novamente" Margin="8,0,0,0"/></StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Jogos" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" Text="{Binding Status}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" Text="{Binding TierText}"/>
            </StackPanel>
        </DockPanel>

        <!-- Sem jogos -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,12,0" Visibility="{Binding NoGames, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="Nenhum jogo encontrado" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" FontSize="13"
                           Text="O Snow procura instalações da Steam, Epic Games e Riot Games. Instale ou abra um jogo pelo launcher e clique em Procurar novamente."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasGames, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de jogos -->
            <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ProfileItem}">
                        <Setter Property="Margin" Value="0,0,6,8"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6">
                                <Run Text="{Binding Store, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SupportLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <WrapPanel>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource WarnBgBrush}" Margin="0,0,6,0"
                                        Visibility="{Binding HasImprovements, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding ImprovementsText}" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding AntiCheat}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detalhe -->
            <DockPanel Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,10,12,0" Visibility="{Binding HasPreset, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="12"
                                   Text="Feche o jogo e o launcher antes. O original fica no backup (aba Restaurar). O Snow só edita o arquivo de configuração, nunca o processo do jogo."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Command="{Binding OpenConfigCommand}" Margin="0,0,10,0" Content="Abrir pasta de configuração"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                                    Visibility="{Binding CanApply, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14"/><TextBlock Text="Aplicar no jogo" Margin="8,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <!-- Cabeçalho do jogo -->
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" FontSize="18"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                    <Run Text="{Binding Selected.Store, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Selected.InstallDir, Mode=OneWay}"/>
                                </TextBlock>
                                <Border Style="{StaticResource Badge}" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource AccentBgBrush}"
                                        Visibility="{Binding Selected.HasAntiCheat, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap">
                                        <Run Text="{Binding Selected.AntiCheat, Mode=OneWay}"/><Run Text=" detectado · modo seguro: só arquivo de configuração, jogo fechado"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Pontos de melhora -->
                        <TextBlock Text="Pontos de melhora" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Box" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock x:Name="Ic" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Importante">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BadBgBrush}"/>
                                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Melhoria">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Ok">
                                            <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Predefinições -->
                        <StackPanel Visibility="{Binding HasPreset, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Predefinição para o seu hardware" Style="{StaticResource H2}" Margin="0,16,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <RadioButton GroupName="preset" IsChecked="{Binding IsMedio, Mode=TwoWay}" Style="{StaticResource NavButton}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS Médio" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Qualidade e estabilidade" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="preset" IsChecked="{Binding IsAlto, Mode=TwoWay}" Style="{StaticResource NavButton}" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS Alto" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Competitivo · menor latência" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Text="{Binding PresetSummary}" Style="{StaticResource Caption}" Margin="2,0,0,8"/>

                            <!-- Tabela de mudanças -->
                            <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasChanges, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <Grid Margin="14,10,14,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OPÇÃO" Style="{StaticResource Caption}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="ATUAL" Style="{StaticResource Caption}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="NOVO" Style="{StaticResource Caption}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="POR QUÊ" Style="{StaticResource Caption}" FontWeight="Bold"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Changes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="New" Grid.Column="2" Text="{Binding Target}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Why}" Style="{StaticResource Caption}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Changes}" Value="True">
                                                        <Setter TargetName="New" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Changes}" Value="False">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Passo a passo (jogos guiados e complementos) -->
                            <StackPanel Visibility="{Binding HasSteps, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource H2}" Margin="0,14,0,8" FontSize="14">
                                    <Run Text="No menu do jogo"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Body}">
                                                        <Run Text="{Binding Setting, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" → "/><Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Where, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Why, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
