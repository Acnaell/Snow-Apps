<UserControl x:Class="Snow.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Health}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <DockPanel Margin="0,0,12,18">
                <Button DockPanel.Dock="Right" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/><TextBlock Text="Analisar novamente" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Saúde do PC" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"
                               Text="Somente leitura: discos (SMART), estabilidade nos últimos 30 dias, drivers, espaço, bateria, placa-mãe, TPM e Secure Boot. Nada é alterado."/>
                </StackPanel>
            </DockPanel>

            <!-- Nota -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="104" Height="104" CornerRadius="52" BorderThickness="7" BorderBrush="{Binding ScoreBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Score}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="de 100" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" FontSize="20">
                            <Run Text="Saúde: "/><Run Text="{Binding Verdict, Mode=OneWay}" Foreground="{Binding ScoreBrush, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,12"/>
                        <WrapPanel>
                            <Button Command="{Binding OpenReliabilityCommand}" Margin="0,0,8,6" Content="Monitor de Confiabilidade"/>
                            <Button Command="{Binding OpenDeviceManagerCommand}" Margin="0,0,8,6" Content="Gerenciador de Dispositivos"/>
                            <Button Command="{Binding OpenStorageCommand}" Margin="0,0,8,6" Content="Armazenamento do Windows"/>
                            <Button Command="{Binding OpenTpmCommand}" Margin="0,0,8,6" Content="TPM (tpm.msc)"/>
                            <Button Command="{Binding OpenSysInfoCommand}" Margin="0,0,8,6" Content="Informações do Sistema"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Achados por categoria -->
            <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,12,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Box" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,6">
                            <DockPanel>
                                <TextBlock x:Name="Ic" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}">
                                        <Run Text="O que fazer: " FontWeight="SemiBold"/><Run Text="{Binding Action, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Critico">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BadBgBrush}"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Atencao">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Ok">
                                <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
