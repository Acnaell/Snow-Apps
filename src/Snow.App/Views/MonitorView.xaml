<UserControl x:Class="Snow.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Monitor}">
    <UserControl.Resources>
        <DataTemplate x:Key="Metric">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <TextBlock Text="Desempenho" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,16"
                       Text="Uso do hardware pelos contadores do Windows e FPS pelo Intel PresentMon (eventos ETW). Nada é injetado no jogo e não há drivers: seguro para Riot Vanguard, EAC e BattlEye."/>

            <!-- PresentMon ausente -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Background="{DynamicResource WarnBgBrush}" Visibility="{Binding NeedsPresentMon, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DownloadPresentMonCommand}" Content="Baixar PresentMon (Intel)" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="Para medir FPS, baixe o 'PresentMon-&lt;versão&gt;-x64.exe' oficial e salve em Downloads. Sem ele, o Monitor mede só o uso do hardware."/>
                </DockPanel>
            </Border>

            <!-- Controles -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13"/><TextBlock Text="Iniciar" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13"/><TextBlock Text="Parar e salvar" Margin="8,0,0,0"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                        <!-- sem o template padrão: desabilitado (durante a medição) ele pintava um fundo branco -->
                        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ProfileItem}">
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="-4,-6"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,0,0,10"/>

            <!-- Métricas ao vivo -->
            <UniformGrid Columns="7" Margin="0,0,2,0">
                <ContentPresenter Content="{Binding Fps}" Tag="FPS" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Low1}" Tag="1% low" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Cpu}" Tag="CPU" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Core}" Tag="Núcleo + ocupado" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Gpu}" Tag="GPU 3D" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Vram}" Tag="VRAM" ContentTemplate="{StaticResource Metric}"/>
                <ContentPresenter Content="{Binding Ram}" Tag="RAM" ContentTemplate="{StaticResource Metric}"/>
            </UniformGrid>

            <!-- Veredito + gráfico -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource H2}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,10"/>
                    <TextBlock Text="{Binding ChartLabel}" Style="{StaticResource Caption}"/>
                    <Border Height="96" Margin="0,4,0,0" Background="{DynamicResource Surface2Brush}" CornerRadius="6" ClipToBounds="True">
                        <Viewbox Stretch="Fill">
                            <Canvas Width="600" Height="92">
                                <Polyline Points="{Binding Chart}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Resumo da sessão -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Visibility="{Binding HasSession, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="Resumo da sessão" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding SessionSummary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,10"/>
                    <ItemsControl ItemsSource="{Binding TimeShare}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Width="220" Text="{Binding Label}" Style="{StaticResource Body}"/>
                                    <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" Style="{StaticResource Body}">
                                        <Run Text="{Binding Percent, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Upgrade sem gargalo -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Upgrade sem gargalo" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding UpgradeBasis}" Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Upgrades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border x:Name="Pill" Style="{StaticResource Badge}" HorizontalAlignment="Left" Background="{DynamicResource Surface2Brush}">
                                                <TextBlock x:Name="PillText" Text="{Binding Priority}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Component}" Style="{StaticResource Caption}" Margin="2,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAvoid}" Value="True">
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Comparar antes/depois -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding PickBeforeCommand}" Content="Escolher ANTES" Margin="0,0,8,0"/>
                            <Button Command="{Binding PickAfterCommand}" Content="Escolher DEPOIS" Margin="0,0,8,0"/>
                            <Button Command="{Binding OpenBenchFolderCommand}" Content="Abrir pasta"/>
                        </StackPanel>
                        <TextBlock Text="Comparar antes e depois" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CompareStatus}" Style="{StaticResource Caption}" Margin="0,6,0,8"/>
                    <ItemsControl ItemsSource="{Binding Comparison}" Visibility="{Binding HasComparison, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Metric}" Style="{StaticResource Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding After}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="D" Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Better}" Value="True">
                                        <Setter TargetName="D" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
