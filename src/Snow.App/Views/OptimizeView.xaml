<UserControl x:Class="Snow.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedTweaks" Source="{Binding Tweaks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel>
        <!-- Barra de ação fixa -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding PurgeStandbyCommand}" Margin="0,0,10,0" ToolTip="Libera a memória em cache (Standby) agora. Efeito temporário.">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE964;" FontSize="13"/><TextBlock Text="Limpar Standby" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14"/><TextBlock Text="Aplicar otimizações" Margin="8,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <CheckBox IsChecked="{Binding CreateRestorePoint}" Margin="0,6,0,0">
                        <TextBlock Text="Criar ponto de restauração do Windows antes (recomendado)" Style="{StaticResource Caption}" FontSize="12.5"/>
                    </CheckBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,20,40">
                <TextBlock Text="Perfis de otimização" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,18"
                           Text="Escolha um perfil. Ajustes que não fazem sentido para o seu hardware ficam desativados, com o motivo. Você pode marcar ou desmarcar item a item."/>

                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProfileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Badge}" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{DynamicResource AccentGradient}"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="RECOMENDADO PARA SEU PC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,6,0,10"/>
                                <ItemsControl ItemsSource="{Binding Bullets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2" Foreground="{DynamicResource TextBrush}">
                                                <Run Text="•" Foreground="{DynamicResource AccentBrush}"/> <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Margin="0,28,12,6">
                    <Button DockPanel.Dock="Right" Command="{Binding SelectAllRecommendedCommand}" Content="Voltar à seleção do perfil"/>
                    <TextBlock Text="O que será alterado" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedTweaks}}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,18,0,8"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,8">
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsApplicable}" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,0,10,4"/>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4"><TextBlock Text="{Binding ImpactText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource WarnBgBrush}" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Requer reiniciar" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource WarnBgBrush}" Visibility="{Binding IsRisky, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Avançado" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource BadBgBrush}" Visibility="{Binding Irreversible, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Irreversível" FontSize="10.5" Foreground="{DynamicResource BadBrush}"/></Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Opacity="0.85"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0">
                                            <Run Text="Na prática:" FontWeight="SemiBold"/> <Run Text="{Binding HonestNote, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="StateText" Text="{Binding StateText}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource GoodBrush}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasState, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock x:Name="ReasonText" Text="{Binding Reason}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,5,0,0" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding ActionsText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WasUndone}" Value="True">
                                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAlreadyApplied}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsApplicable}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.75"/>
                                    <Setter TargetName="ReasonText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Resultado da última aplicação -->
                <Border Style="{StaticResource Card}" Margin="0,18,12,0" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Resultado da última aplicação" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding LastResult}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" Style="{StaticResource Body}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
