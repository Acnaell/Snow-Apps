<UserControl x:Class="Snow.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Processes}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <DockPanel Margin="0,0,12,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13"/><TextBlock Text="Analisar (10 s)" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Processos em segundo plano" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Mede o que roda junto com o jogo e diz o que vale fechar ou tirar da inicialização. O uso vem das contagens do Windows: o Snow não abre jogos nem anti-cheat."/>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Box" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,12,6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Tirar da inicialização" Margin="0,0,8,0" Visibility="{Binding StartupOn, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.DisableStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Fechar" Visibility="{Binding CanClose, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Atencao">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
