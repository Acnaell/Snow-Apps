<UserControl x:Class="Snow.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <TextBlock Text="Restaurar" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,18"
                       Text="Cada aplicação salva o valor original de tudo o que foi alterado (registro, serviços, plano de energia, rede, inicialização). Restaurar devolve exatamente esses valores. Limpezas de arquivos não têm volta."/>

            <WrapPanel Margin="0,0,0,18">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RestoreAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="14"/><TextBlock Text="Reverter tudo" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <Button Command="{Binding OpenSystemRestoreCommand}" Margin="0,0,10,0" Content="Abrir Restauração do Sistema do Windows"/>
                <Button Command="{Binding OpenDataFolderCommand}" Content="Abrir pasta de backups e logs"/>
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restaurar" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
