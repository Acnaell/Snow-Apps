<UserControl x:Class="Snow.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,20,90">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshStartupCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/><TextBlock Text="Atualizar" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Inicialização" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,18"
                               Text="Mesmo mecanismo do Gerenciador de Tarefas: desativar não apaga nada, o app só deixa de abrir sozinho. Itens destacados são launchers/apps conhecidos por pesar no boot."/>
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding StartupItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,8">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                          ToolTip="Abrir com o Windows"/>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                        <Border x:Name="Heavy" Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource WarnBgBrush}" Visibility="Collapsed">
                                            <TextBlock Text="pesado no boot" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                        <Run Text="{Binding Location, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Command, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsKnownHeavy}" Value="True">
                                <Setter TargetName="Heavy" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
